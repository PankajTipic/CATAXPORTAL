import React, { useState, useEffect, useRef } from "react";
import {
  CCard,
  CCardHeader,
  CCardBody,
  CForm,
  CFormInput,
  CButton,
  CSpinner,
  CBadge,
} from "@coreui/react";
import api from "../api/client";

export default function AgentChat({ requestId, isAgentOrAdmin = false, currentUserName = "You" }) {
  const [messages, setMessages] = useState([]);
  const [inputMessage, setInputMessage] = useState("");
  const [sending, setSending] = useState(false);
  const [loading, setLoading] = useState(true);
  const [attachment, setAttachment] = useState(null);
  const chatBottomRef = useRef(null);

  const fetchMessages = async () => {
    if (!requestId) return;
    try {
      const { data } = await api.get(`/agent-requests/${requestId}/chat`);
      if (data.status === "success") {
        setMessages(data.data || []);
      }
    } catch (err) {
      console.error("Failed to load chat:", err);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchMessages();
    const interval = setInterval(fetchMessages, 4000); // 4-sec polling for interactive messaging
    return () => clearInterval(interval);
  }, [requestId]);

  useEffect(() => {
    chatBottomRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages]);

  const handleSendMessage = async (e) => {
    e.preventDefault();
    if (!inputMessage.trim() && !attachment) return;

    setSending(true);
    try {
      const formData = new FormData();
      formData.append("message", inputMessage.trim() || "Sent an attachment");
      if (attachment) {
        formData.append("attachment", attachment);
      }

      const { data } = await api.post(`/agent-requests/${requestId}/chat`, formData, {
        headers: { "Content-Type": "multipart/form-data" },
      });

      if (data.status === "success") {
        setMessages((prev) => [...prev, data.data]);
        setInputMessage("");
        setAttachment(null);
      }
    } catch (err) {
      alert(err.response?.data?.message || "Failed to send message.");
    } finally {
      setSending(false);
    }
  };

  return (
    <CCard className="border-0" style={{ borderRadius: "16px", overflow: "hidden", border: "1px solid #e2e8f0", boxShadow: "0 4px 20px rgba(0,0,0,0.04)" }}>
      <CCardHeader
        style={{
          background: "linear-gradient(135deg, #0b1f3a 0%, #1e3a8a 100%)",
          color: "#ffffff",
          padding: "16px 22px",
          borderBottom: "1px solid rgba(255,255,255,0.1)",
        }}
        className="d-flex justify-content-between align-items-center flex-wrap gap-2"
      >
        <div>
          <div style={{ fontWeight: "800", fontSize: "15px", display: "flex", alignItems: "center", gap: "9px" }}>
            <span>💬 Live Chat with CA Staff</span>
            <span
              style={{
                width: "8px",
                height: "8px",
                borderRadius: "50%",
                background: "#22c55e",
                display: "inline-block",
                boxShadow: "0 0 10px #22c55e",
              }}
            />
          </div>
          <div style={{ fontSize: "12px", color: "#94a3b8", marginTop: "2px" }}>
            Case ID #{requestId} • Real-time CA consultation &amp; document queries
          </div>
        </div>
        <CBadge style={{ background: "rgba(34,197,94,0.15)", color: "#22c55e", border: "1px solid rgba(34,197,94,0.3)", padding: "5px 10px", fontSize: "11px", fontWeight: "700" }}>
          ● Specialist Online
        </CBadge>
      </CCardHeader>

      <CCardBody style={{ padding: "0", background: "#f8fafc" }}>
        {/* Messages Stream */}
        <div
          style={{
            height: "360px",
            overflowY: "auto",
            padding: "20px",
            display: "flex",
            flexDirection: "column",
            gap: "14px",
          }}
        >
          {loading ? (
            <div className="text-center my-auto text-muted" style={{ fontSize: "13px" }}>
              <CSpinner size="sm" className="me-2" style={{ color: "#10b981" }} /> Loading discussion...
            </div>
          ) : messages.length === 0 ? (
            <div className="text-center my-auto" style={{ color: "#94a3b8", fontSize: "13px", padding: "20px" }}>
              <div style={{ fontSize: "40px", marginBottom: "8px" }}>👋</div>
              <strong style={{ color: "#334155", fontSize: "14px" }}>No messages yet</strong>
              <div style={{ marginTop: "6px", maxWidth: "380px", marginInline: "auto", lineHeight: "1.5" }}>
                Say hello! You can ask questions, clarify deductions, or request guidance from your assigned CA.
              </div>
            </div>
          ) : (
            messages.map((msg) => {
              const senderRole = msg.sender?.role || "customer";
              const isMe = isAgentOrAdmin ? senderRole !== "customer" : senderRole === "customer";
              const formattedTime = new Date(msg.created_at).toLocaleTimeString([], {
                hour: "2-digit",
                minute: "2-digit",
              });

              return (
                <div
                  key={msg.id}
                  style={{
                    alignSelf: isMe ? "flex-end" : "flex-start",
                    maxWidth: "80%",
                  }}
                >
                  <div
                    style={{
                      fontSize: "11px",
                      fontWeight: "700",
                      marginBottom: "4px",
                      color: isMe ? "#0b3d91" : "#475569",
                      textAlign: isMe ? "right" : "left",
                    }}
                  >
                    {isMe ? "You" : msg.sender?.name || "CA Staff"}
                    {senderRole === "employee" && (
                      <span style={{ marginLeft: "6px", padding: "2px 6px", borderRadius: "4px", background: "#e0f2fe", color: "#0284c7", fontSize: "10px", fontWeight: "700" }}>
                        CA Specialist
                      </span>
                    )}
                    {senderRole === "admin" && (
                      <span style={{ marginLeft: "6px", padding: "2px 6px", borderRadius: "4px", background: "#fef2f2", color: "#dc2626", fontSize: "10px", fontWeight: "700" }}>
                        CA Partner
                      </span>
                    )}
                  </div>
                  <div
                    style={{
                      background: isMe
                        ? "linear-gradient(135deg, #0b3d91 0%, #1e40af 100%)"
                        : "#ffffff",
                      color: isMe ? "#ffffff" : "#1e293b",
                      padding: "12px 16px",
                      borderRadius: isMe ? "16px 16px 2px 16px" : "16px 16px 16px 2px",
                      boxShadow: "0 2px 8px rgba(0,0,0,0.05)",
                      fontSize: "13.5px",
                      lineHeight: "1.55",
                      border: isMe ? "none" : "1px solid #e2e8f0",
                    }}
                  >
                    <div>{msg.message}</div>
                    {msg.attachment_path && (
                      <div style={{ marginTop: "8px" }}>
                        <a
                          href={msg.attachment_path}
                          target="_blank"
                          rel="noreferrer"
                          style={{
                            display: "inline-flex",
                            alignItems: "center",
                            gap: "6px",
                            padding: "5px 10px",
                            borderRadius: "6px",
                            background: isMe ? "rgba(255,255,255,0.18)" : "#f1f5f9",
                            color: isMe ? "#ffffff" : "#0b3d91",
                            textDecoration: "none",
                            fontSize: "12px",
                            fontWeight: "600",
                          }}
                        >
                          📎 View Attached File
                        </a>
                      </div>
                    )}
                    <div
                      style={{
                        fontSize: "10px",
                        textAlign: "right",
                        marginTop: "5px",
                        opacity: isMe ? 0.8 : 0.6,
                      }}
                    >
                      {formattedTime}
                    </div>
                  </div>
                </div>
              );
            })
          )}
          <div ref={chatBottomRef} />
        </div>

        {/* Input Bar */}
        <div style={{ padding: "12px 16px", background: "#ffffff", borderTop: "1px solid #e2e8f0" }}>
          {attachment && (
            <div
              className="d-flex align-items-center justify-content-between p-2 mb-2 rounded"
              style={{ background: "#f0fdf4", border: "1px solid #bbf7d0", fontSize: "12px", color: "#166534" }}
            >
              <span>📎 Selected: <strong>{attachment.name}</strong></span>
              <button
                type="button"
                onClick={() => setAttachment(null)}
                className="btn btn-sm text-danger p-0 fw-bold border-0 bg-transparent"
              >
                ✕ Remove
              </button>
            </div>
          )}

          <CForm onSubmit={handleSendMessage} className="d-flex gap-2 align-items-center">
            <label
              htmlFor={`chat_file_${requestId}`}
              className="btn btn-light m-0 d-flex align-items-center justify-content-center"
              style={{
                cursor: "pointer",
                borderRadius: "10px",
                border: "1px solid #cbd5e1",
                padding: "8px 12px",
                background: "#f8fafc",
              }}
              title="Attach document or screenshot"
            >
              📎
              <input
                id={`chat_file_${requestId}`}
                type="file"
                style={{ display: "none" }}
                onChange={(e) => setAttachment(e.target.files[0] || null)}
              />
            </label>

            <CFormInput
              placeholder="Type your question or message to CA..."
              value={inputMessage}
              onChange={(e) => setInputMessage(e.target.value)}
              style={{
                borderRadius: "10px",
                fontSize: "14px",
                padding: "9px 14px",
                borderColor: "#cbd5e1",
              }}
              disabled={sending}
            />

            <CButton
              type="submit"
              color="primary"
              disabled={sending || (!inputMessage.trim() && !attachment)}
              style={{
                borderRadius: "10px",
                padding: "9px 20px",
                fontWeight: "700",
                background: "linear-gradient(135deg, #0b3d91 0%, #1e40af 100%)",
                border: "none",
                display: "flex",
                alignItems: "center",
                gap: "6px",
              }}
            >
              {sending ? <CSpinner size="sm" /> : "Send"}
            </CButton>
          </CForm>
        </div>
      </CCardBody>
    </CCard>
  );
}
