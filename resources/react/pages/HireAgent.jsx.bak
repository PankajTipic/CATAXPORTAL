import React, { useState, useEffect } from "react";
import { useNavigate, useSearchParams } from "react-router-dom";
import {
  CContainer,
  CRow,
  CCol,
  CSpinner,
  CForm,
  CBadge,
  CAlert,
  CModal,
  CModalHeader,
  CModalTitle,
  CModalBody,
} from "@coreui/react";
import api from "../api/client";
import AgentChat from "../components/AgentChat";
import ContactUsModal from "../components/ContactUsModal";
import TaxComputationDossier from "../components/TaxComputationDossier";

export default function HireAgent() {
  const navigate = useNavigate();
  const [searchParams] = useSearchParams();
  const user = JSON.parse(localStorage.getItem("user") || "{}");
  const storedPan = localStorage.getItem("user_pan") || user.pan || "ABCDE1234F";

  const [activeTab, setActiveTab] = useState("my_cases");
  const [showDossierModal, setShowDossierModal] = useState(false);

  // ── CA-Assisted Payment Gate State ──
  const [caPaymentCompleted, setCaPaymentCompleted] = useState(false);
  const [caPaymentProcessing, setCaPaymentProcessing] = useState(false);
  const [caPaymentInfo, setCaPaymentInfo] = useState(null);
  const CA_FILING_FEE = 1499;  // ₹1,499 CA-assisted filing fee
  const CA_FILING_FEE_GST = Math.round(CA_FILING_FEE * 0.18);
  const CA_FILING_FEE_TOTAL = CA_FILING_FEE + CA_FILING_FEE_GST;

  const handleLogout = async () => {
    try {
      await api.post("/auth/logout");
    } catch (err) {
      // ignore network errors on logout
    } finally {
      localStorage.removeItem("auth_token");
      localStorage.removeItem("user");
      localStorage.removeItem("tax_data");
      localStorage.removeItem("user_pan");
      localStorage.removeItem("preferred_filing_flow");
      localStorage.removeItem("is_ca_staff");
      sessionStorage.clear();
      navigate("/login", { replace: true });
    }
  };

  const [myRequests, setMyRequests] = useState([]);
  const [selectedRequest, setSelectedRequest] = useState(null);
  const [loadingRequests, setLoadingRequests] = useState(true);
  const [serviceType, setServiceType] = useState("full_filing");
  const [assessmentYear, setAssessmentYear] = useState("2026-27");
  const [selectedSources, setSelectedSources] = useState(["Salary", "Bank Interest"]);
  const [notes, setNotes] = useState("");
  const [files, setFiles] = useState([]);
  const [submitting, setSubmitting] = useState(false);
  const [feedback, setFeedback] = useState({ type: "", message: "" });
  const [showContactModal, setShowContactModal] = useState(false);
  const [showChatModal, setShowChatModal] = useState(false);

  const incomeSourceOptions = [
    "Salary / Form 16",
    "Bank Interest & FDs",
    "House Property / Rent",
    "Capital Gains (Shares / Mutual Funds / Property)",
    "Business / Freelance / Profession (44ADA/44AD)",
    "Crypto / Foreign Assets / Dividends",
  ];

  const fetchMyRequests = async () => {
    setLoadingRequests(true);
    try {
      const { data } = await api.get("/agent/my-requests");
      if (data.status === "success") {
        const reqs = data.data || [];
        setMyRequests(reqs);
        if (reqs.length > 0) {
          setSelectedRequest((prev) => {
            if (!prev) return reqs[0];
            const updated = reqs.find((r) => r.id === prev.id);
            return updated || reqs[0];
          });
        }
      }
    } catch (err) {
      console.error("Failed to load requests:", err);
    } finally {
      setLoadingRequests(false);
    }
  };

  /* ── Razorpay: CA-Assisted Filing Payment ── */
  const loadRazorpayScript = () => new Promise((resolve) => {
    if (window.Razorpay) { resolve(true); return; }
    const s = document.createElement('script');
    s.src = 'https://checkout.razorpay.com/v1/checkout.js';
    s.onload = () => resolve(true);
    s.onerror = () => resolve(false);
    document.body.appendChild(s);
  });

  const handleCaAssistedPayNow = async () => {
    setCaPaymentProcessing(true);
    try {
      const loaded = await loadRazorpayScript();
      if (!loaded) {
        alert('Razorpay SDK failed to load. Check your internet connection.');
        setCaPaymentProcessing(false);
        return;
      }
      const pan = storedPan;
      const ay = selectedRequest?.assessment_year || '2026-27';
      const { data: orderData } = await api.post('/payment/create-order', {
        amount: CA_FILING_FEE_TOTAL,
        pan,
        assessment_year: ay,
        filing_type: 'ca_assisted',
      });
      const options = {
        key: orderData.key_id || 'rzp_test_QOHcXj0D8froB9',
        amount: orderData.amount_in_paise,
        currency: 'INR',
        name: 'CA Tax Portal',
        description: `CA-Assisted Filing Fee – AY ${ay}`,
        order_id: orderData.order_id,
        prefill: orderData.prefill || { name: user.name || 'Taxpayer', email: user.email || '' },
        theme: { color: '#15803d' },
        modal: { ondismiss: () => setCaPaymentProcessing(false) },
        handler: async (response) => {
          try {
            const { data: verifyData } = await api.post('/payment/verify', {
              razorpay_order_id: response.razorpay_order_id,
              razorpay_payment_id: response.razorpay_payment_id,
              razorpay_signature: response.razorpay_signature,
              pan,
              assessment_year: ay,
            });
            if (verifyData.status === 'success') {
              setCaPaymentCompleted(true);
              setCaPaymentInfo({
                razorpay_payment_id: response.razorpay_payment_id,
                amount: CA_FILING_FEE_TOTAL,
                paid_at: new Date().toISOString(),
              });
            } else {
              alert('Payment verification failed. Please contact support.');
            }
          } catch (e) {
            alert('Verification error: ' + (e?.response?.data?.message || e.message));
          } finally {
            setCaPaymentProcessing(false);
          }
        },
      };
      const rzp = new window.Razorpay(options);
      rzp.on('payment.failed', (resp) => {
        alert('Payment failed: ' + (resp.error?.description || 'Unknown error'));
        setCaPaymentProcessing(false);
      });
      rzp.open();
    } catch (e) {
      alert('Could not initiate payment: ' + (e?.response?.data?.message || e.message));
      setCaPaymentProcessing(false);
    }
  };

  useEffect(() => {
    fetchMyRequests();
  }, []);

  const toggleSource = (source) => {
    setSelectedSources((prev) =>
      prev.includes(source) ? prev.filter((s) => s !== source) : [...prev, source]
    );
  };

  const handleFileChange = (e) => {
    setFiles(Array.from(e.target.files));
  };

  const handleSubmitRequest = async (e) => {
    e.preventDefault();
    setSubmitting(true);
    setFeedback({ type: "", message: "" });
    try {
      const formData = new FormData();
      formData.append("service_type", serviceType);
      formData.append("assessment_year", assessmentYear);
      formData.append("notes", notes);
      formData.append("pan", storedPan);
      selectedSources.forEach((src) => formData.append("income_sources[]", src));
      files.forEach((file) => {
        formData.append("documents[]", file);
      });
      const { data } = await api.post("/agent/request", formData, {
        headers: { "Content-Type": "multipart/form-data" },
      });
      setFeedback({
        type: "success",
        message: "Your CA Agent Request has been booked successfully! Our CA team will assign your dedicated specialist.",
      });
      await fetchMyRequests();
      if (data.data) setSelectedRequest(data.data);
      setActiveTab("my_cases");
      setNotes("");
      setFiles([]);
    } catch (err) {
      setFeedback({
        type: "danger",
        message: err.response?.data?.message || "Failed to submit request. Please try again.",
      });
    } finally {
      setSubmitting(false);
    }
  };

  const getStatusBadge = (status) => {
    switch (status) {
      case "pending":
        return (
          <span
            style={{
              display: "inline-flex",
              alignItems: "center",
              gap: "4px",
              padding: "4px 12px",
              borderRadius: "100px",
              fontSize: "12px",
              fontWeight: "700",
              color: "#b45309",
              background: "#fef3c7",
              border: "1px solid #fde68a",
            }}
          >
            ⏳ Awaiting CA Assignment
          </span>
        );
      case "assigned":
        return (
          <span
            style={{
              display: "inline-flex",
              alignItems: "center",
              gap: "4px",
              padding: "4px 12px",
              borderRadius: "100px",
              fontSize: "12px",
              fontWeight: "700",
              color: "#0369a1",
              background: "#e0f2fe",
              border: "1px solid #bae6fd",
            }}
          >
            👨‍💼 CA Specialist Assigned
          </span>
        );
      case "in_progress":
        return (
          <span
            style={{
              display: "inline-flex",
              alignItems: "center",
              gap: "4px",
              padding: "4px 12px",
              borderRadius: "100px",
              fontSize: "12px",
              fontWeight: "700",
              color: "#4338ca",
              background: "#e0e7ff",
              border: "1px solid #c7d2fe",
            }}
          >
            ⚡ Computation In Progress
          </span>
        );
      case "prepared":
        return (
          <span
            style={{
              display: "inline-flex",
              alignItems: "center",
              gap: "4px",
              padding: "4px 12px",
              borderRadius: "100px",
              fontSize: "12px",
              fontWeight: "700",
              color: "#15803d",
              background: "#dcfce7",
              border: "1px solid #bbf7d0",
            }}
          >
            ✅ File Ready for Download
          </span>
        );
      case "completed":
        return (
          <span
            style={{
              display: "inline-flex",
              alignItems: "center",
              gap: "4px",
              padding: "4px 12px",
              borderRadius: "100px",
              fontSize: "12px",
              fontWeight: "700",
              color: "#334155",
              background: "#f1f5f9",
              border: "1px solid #cbd5e1",
            }}
          >
            🏁 Filed & Completed
          </span>
        );
      default:
        return (
          <span
            style={{
              display: "inline-flex",
              alignItems: "center",
              padding: "4px 12px",
              borderRadius: "100px",
              fontSize: "12px",
              fontWeight: "700",
              color: "#64748b",
              background: "#f8fafc",
              border: "1px solid #e2e8f0",
            }}
          >
            {status}
          </span>
        );
    }
  };

  const cardStyle = {
    background: "#ffffff",
    border: "1px solid #e2e8f0",
    borderRadius: "16px",
    boxShadow: "0 4px 20px rgba(0, 0, 0, 0.04)",
  };

  return (
    <div
      style={{
        background: "#f8fafc",
        minHeight: "100vh",
        paddingBottom: "80px",
        fontFamily: "'Inter', sans-serif",
      }}
    >
      {/* ═══════════ TOP NAVBAR (Identical to Self-Filing) ═══════════ */}
      <nav
        style={{
          background: "#0b1f3a",
          color: "#fff",
          padding: "16px 0",
          borderBottom: "3px solid #10b981",
        }}
      >
        <CContainer>
          <div className="d-flex justify-content-between align-items-center flex-wrap gap-3">
            {/* Left: Brand + User Metadata */}
            <div>
              <div className="d-flex align-items-center gap-2">
                <span style={{ fontSize: "22px" }}>🏛️</span>
                <span
                  style={{
                    fontWeight: "900",
                    fontSize: "18px",
                    letterSpacing: "0.5px",
                    color: "#ffffff",
                  }}
                >
                  CA TAX PORTAL
                </span>
                <span
                  style={{
                    background: "linear-gradient(135deg, #10b981, #059669)",
                    color: "#ffffff",
                    fontSize: "10.5px",
                    fontWeight: "800",
                    padding: "3px 10px",
                    borderRadius: "12px",
                    letterSpacing: "0.5px",
                  }}
                >
                  EXPERT CA ASSISTED
                </span>
              </div>
              <div
                style={{
                  fontSize: "12px",
                  color: "#94a3b8",
                  marginTop: "3px",
                }}
              >
                Client:{" "}
                <strong style={{ color: "#ffffff" }}>
                  {user.name || "Taxpayer"}
                </strong>{" "}
                &nbsp;|&nbsp; PAN:{" "}
                <strong style={{ color: "#38bdf8" }}>{storedPan}</strong>{" "}
                &nbsp;|&nbsp; AY 2026-27
              </div>
            </div>

            {/* Right: Actions */}
            <div className="d-flex align-items-center gap-2 flex-wrap">

              <button
                onClick={() => setShowContactModal(true)}
                style={{
                  background: "rgba(255,255,255,0.12)",
                  border: "1px solid rgba(255,255,255,0.25)",
                  color: "#ffffff",
                  padding: "8px 16px",
                  borderRadius: "8px",
                  fontSize: "13px",
                  fontWeight: "700",
                  cursor: "pointer",
                  display: "flex",
                  alignItems: "center",
                  gap: "6px",
                  transition: "all 0.15s",
                }}
                onMouseEnter={(e) => {
                  e.currentTarget.style.background = "rgba(255,255,255,0.2)";
                }}
                onMouseLeave={(e) => {
                  e.currentTarget.style.background = "rgba(255,255,255,0.12)";
                }}
              >
                💬 Contact Support
              </button>

              <button
                onClick={handleLogout}
                style={{
                  background: "#dc2626",
                  border: "1px solid #ef4444",
                  color: "#ffffff",
                  padding: "8px 18px",
                  borderRadius: "8px",
                  fontSize: "13px",
                  fontWeight: "800",
                  cursor: "pointer",
                  display: "flex",
                  alignItems: "center",
                  gap: "6px",
                  boxShadow: "0 2px 8px rgba(220, 38, 38, 0.4)",
                  transition: "all 0.15s",
                }}
                onMouseEnter={(e) => {
                  e.currentTarget.style.background = "#b91c1c";
                }}
                onMouseLeave={(e) => {
                  e.currentTarget.style.background = "#dc2626";
                }}
                title="Log out of your account"
              >
                🔒 Logout
              </button>
            </div>
          </div>
        </CContainer>
      </nav>

      {/* ═══════════ LIVE SUMMARY HEADER BAR ═══════════ */}
      <div
        style={{
          background: "#ffffff",
          borderBottom: "1px solid #e2e8f0",
          padding: "14px 0",
          boxShadow: "0 2px 8px rgba(0,0,0,0.03)",
        }}
      >
        <CContainer>
          <div className="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div className="d-flex align-items-center gap-4 flex-wrap">
              <div>
                <div
                  style={{
                    fontSize: "11px",
                    color: "#64748b",
                    fontWeight: "700",
                    textTransform: "uppercase",
                  }}
                >
                  Active Case
                </div>
                <div
                  style={{
                    fontSize: "15px",
                    fontWeight: "900",
                    color: "#0b3d91",
                  }}
                >
                  {selectedRequest
                    ? `Case #${selectedRequest.id} (AY ${selectedRequest.assessment_year})`
                    : "No Case Selected"}
                </div>
              </div>

              <div
                style={{ width: "1px", height: "26px", background: "#e2e8f0" }}
              />

              <div>
                <div
                  style={{
                    fontSize: "11px",
                    color: "#64748b",
                    fontWeight: "700",
                    textTransform: "uppercase",
                  }}
                >
                  Assigned Specialist
                </div>
                <div
                  style={{
                    fontSize: "15px",
                    fontWeight: "800",
                    color: selectedRequest?.assigned_employee
                      ? "#0f172a"
                      : "#f59e0b",
                  }}
                >
                  {selectedRequest?.assigned_employee
                    ? `👨‍💼 ${selectedRequest.assigned_employee.name}`
                    : "⏳ Allocation in progress"}
                </div>
              </div>

              <div
                style={{ width: "1px", height: "26px", background: "#e2e8f0" }}
              />

              <div>
                <div
                  style={{
                    fontSize: "11px",
                    color: "#64748b",
                    fontWeight: "700",
                    textTransform: "uppercase",
                  }}
                >
                  Service Type
                </div>
                <div
                  style={{
                    fontSize: "15px",
                    fontWeight: "800",
                    color: "#0284c7",
                  }}
                >
                  {selectedRequest
                    ? selectedRequest.service_type
                        .replace("_", " ")
                        .toUpperCase()
                    : "ITR FILING"}
                </div>
              </div>
            </div>

            {/* Status Pill on Header */}
            <div>
              {selectedRequest?.uploaded_file_path ? (
                <div
                  style={{
                    background: "#f0fdf4",
                    border: "1.5px solid #86efac",
                    borderRadius: "10px",
                    padding: "6px 16px",
                    display: "flex",
                    alignItems: "center",
                    gap: "8px",
                  }}
                >
                  <span style={{ fontSize: "18px" }}>🎉</span>
                  <div>
                    <div
                      style={{
                        fontSize: "10px",
                        fontWeight: "800",
                        color: "#166534",
                        textTransform: "uppercase",
                      }}
                    >
                      Prepared ITR File
                    </div>
                    <div
                      style={{
                        fontSize: "14px",
                        fontWeight: "900",
                        color: "#15803d",
                      }}
                    >
                      Ready for Download
                    </div>
                  </div>
                </div>
              ) : selectedRequest ? (
                <div>{getStatusBadge(selectedRequest.status)}</div>
              ) : null}
            </div>
          </div>
        </CContainer>
      </div>

      {/* ═══════════ MAIN CONTENT ═══════════ */}
      <CContainer className="mt-4">
        {/* Banner Section */}
        <div className="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
          <div>
            <div
              style={{
                display: "inline-flex",
                alignItems: "center",
                gap: "6px",
                background: "#ecfdf5",
                border: "1px solid #a7f3d0",
                borderRadius: "100px",
                padding: "4px 14px",
                color: "#059669",
                fontSize: "11.5px",
                fontWeight: "800",
                letterSpacing: "0.5px",
                textTransform: "uppercase",
                marginBottom: "8px",
              }}
            >
              🏆 Dedicated Chartered Accountant Assistance
            </div>
            <h1
              style={{
                fontSize: "clamp(22px, 3.5vw, 30px)",
                fontWeight: "900",
                color: "#0f172a",
                margin: 0,
                lineHeight: "1.2",
              }}
            >
              Chartered Accountant Filing Console
            </h1>
            <p
              style={{
                color: "#64748b",
                fontSize: "14px",
                margin: "4px 0 0",
              }}
            >
              Track your case progress, communicate directly with your dedicated
              CA, and download your finalized ITR.
            </p>
          </div>

          {/* Navigation Pill Tabs */}
          <div
            style={{
              display: "flex",
              gap: "6px",
              background: "#ffffff",
              border: "1px solid #e2e8f0",
              borderRadius: "12px",
              padding: "5px",
              boxShadow: "0 2px 8px rgba(0,0,0,0.03)",
            }}
          >
            <button
              onClick={() => setActiveTab("my_cases")}
              style={{
                padding: "8px 20px",
                borderRadius: "8px",
                fontWeight: "800",
                fontSize: "13.5px",
                cursor: "pointer",
                border: "none",
                transition: "all 0.15s",
                background:
                  activeTab === "my_cases"
                    ? "linear-gradient(135deg, #0b1f3a 0%, #1e3a8a 100%)"
                    : "transparent",
                color: activeTab === "my_cases" ? "#ffffff" : "#64748b",
                boxShadow:
                  activeTab === "my_cases"
                    ? "0 4px 12px rgba(11,31,58,0.25)"
                    : "none",
              }}
            >
              📋 My CA Cases ({myRequests.length})
            </button>
            <button
              onClick={() => setActiveTab("new_request")}
              style={{
                padding: "8px 20px",
                borderRadius: "8px",
                fontWeight: "800",
                fontSize: "13.5px",
                cursor: "pointer",
                border: "none",
                transition: "all 0.15s",
                background:
                  activeTab === "new_request"
                    ? "linear-gradient(135deg, #10b981 0%, #059669 100%)"
                    : "transparent",
                color: activeTab === "new_request" ? "#ffffff" : "#64748b",
                boxShadow:
                  activeTab === "new_request"
                    ? "0 4px 12px rgba(16,185,129,0.25)"
                    : "none",
              }}
            >
              ➕ Book New CA Service
            </button>
          </div>
        </div>

        {/* Feedback Alert */}
        {feedback.message && (
          <CAlert
            color={feedback.type === "success" ? "success" : "danger"}
            dismissible
            onClose={() => setFeedback({ type: "", message: "" })}
            className="fw-bold mb-4 shadow-sm"
            style={{ borderRadius: "12px" }}
          >
            {feedback.type === "success" ? "✅ " : "⚠️ "}
            {feedback.message}
          </CAlert>
        )}

        {/* ═══════════ VIEW 1: MY ACTIVE CASES ═══════════ */}
        {activeTab === "my_cases" && (
          <div>
            {loadingRequests ? (
              <div style={{ textAlign: "center", padding: "80px 0" }}>
                <CSpinner
                  style={{ color: "#10b981", width: "40px", height: "40px" }}
                />
                <div
                  style={{
                    color: "#64748b",
                    marginTop: "16px",
                    fontWeight: "700",
                    fontSize: "14px",
                  }}
                >
                  Loading your CA requests...
                </div>
              </div>
            ) : myRequests.length === 0 ? (
              /* Empty State */
              <div
                style={{
                  ...cardStyle,
                  textAlign: "center",
                  padding: "64px 32px",
                  maxWidth: "600px",
                  margin: "40px auto",
                }}
              >
                <div style={{ fontSize: "64px", marginBottom: "16px" }}>
                  👨‍💼
                </div>
                <h3
                  style={{
                    fontWeight: "900",
                    color: "#0f172a",
                    marginBottom: "10px",
                    fontSize: "22px",
                  }}
                >
                  No Active CA Filing Cases
                </h3>
                <p
                  style={{
                    color: "#64748b",
                    maxWidth: "460px",
                    margin: "0 auto 26px",
                    lineHeight: "1.65",
                    fontSize: "14px",
                  }}
                >
                  Hire a qualified Chartered Accountant to handle your tax
                  filing, optimize your regime, and submit your ITR — 100%
                  stress-free.
                </p>
                <button
                  onClick={() => setActiveTab("new_request")}
                  style={{
                    padding: "12px 28px",
                    borderRadius: "10px",
                    background:
                      "linear-gradient(135deg, #10b981 0%, #059669 100%)",
                    border: "none",
                    color: "#fff",
                    fontSize: "14px",
                    fontWeight: "800",
                    cursor: "pointer",
                    boxShadow: "0 4px 16px rgba(16,185,129,0.35)",
                  }}
                >
                  Hire a Chartered Accountant Now →
                </button>
              </div>
            ) : (
              <CRow className="g-4">
                {/* ──── Left Column: Requests List ──── */}
                <CCol lg={4}>
                  <div
                    style={{
                      fontWeight: "800",
                      color: "#334155",
                      marginBottom: "14px",
                      fontSize: "15px",
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "space-between",
                    }}
                  >
                    <span>Your Filing Requests</span>
                    <span
                      style={{
                        fontSize: "12px",
                        color: "#64748b",
                        fontWeight: "600",
                      }}
                    >
                      {myRequests.length} Total
                    </span>
                  </div>

                  <div
                    style={{
                      display: "flex",
                      flexDirection: "column",
                      gap: "12px",
                    }}
                  >
                    {myRequests.map((req) => {
                      const isSelected = selectedRequest?.id === req.id;
                      return (
                        <div
                          key={req.id}
                          onClick={() => setSelectedRequest(req)}
                          style={{
                            background: "#ffffff",
                            borderRadius: "14px",
                            padding: "16px 18px",
                            cursor: "pointer",
                            transition: "all 0.18s ease-in-out",
                            border: isSelected
                              ? "2px solid #10b981"
                              : "1px solid #e2e8f0",
                            boxShadow: isSelected
                              ? "0 6px 20px rgba(16,185,129,0.12)"
                              : "0 2px 6px rgba(0,0,0,0.03)",
                            borderLeft: isSelected
                              ? "6px solid #10b981"
                              : "1px solid #e2e8f0",
                            transform: isSelected ? "translateY(-1px)" : "none",
                          }}
                        >
                          <div
                            style={{
                              display: "flex",
                              justifyContent: "space-between",
                              alignItems: "center",
                              marginBottom: "8px",
                            }}
                          >
                            <span
                              style={{
                                fontWeight: "900",
                                color: isSelected ? "#059669" : "#0f172a",
                                fontSize: "15px",
                              }}
                            >
                              Case #{req.id}
                            </span>
                            {getStatusBadge(req.status)}
                          </div>

                          <div
                            style={{
                              fontSize: "12.5px",
                              color: "#475569",
                              fontWeight: "600",
                            }}
                          >
                            AY {req.assessment_year} •{" "}
                            {req.service_type.replace("_", " ").toUpperCase()}
                          </div>

                          <div
                            style={{
                              fontSize: "12px",
                              color: "#64748b",
                              marginTop: "6px",
                              display: "flex",
                              alignItems: "center",
                              gap: "4px",
                            }}
                          >
                            <span>CA:</span>
                            <span
                              style={{
                                color: req.assigned_employee
                                  ? "#0f172a"
                                  : "#f59e0b",
                                fontWeight: "700",
                              }}
                            >
                              {req.assigned_employee
                                ? req.assigned_employee.name
                                : "Awaiting Assignment"}
                            </span>
                          </div>

                          {req.uploaded_file_path && (
                            <div
                              style={{
                                marginTop: "10px",
                                padding: "6px 10px",
                                background: "#f0fdf4",
                                color: "#166534",
                                borderRadius: "8px",
                                fontSize: "11.5px",
                                fontWeight: "800",
                                border: "1px solid #bbf7d0",
                                display: "flex",
                                alignItems: "center",
                                gap: "6px",
                              }}
                            >
                              <span>📥</span> ITR File Ready for Download!
                            </div>
                          )}
                        </div>
                      );
                    })}
                  </div>
                </CCol>

                {/* ──── Right Column: Selected Case Details & Live Chat ──── */}
                <CCol lg={8}>
                  {selectedRequest ? (
                    <div>
                      {/* Case Overview & Progress Card */}
                      <div
                        style={{
                          ...cardStyle,
                          marginBottom: "20px",
                          overflow: "hidden",
                        }}
                      >
                        {/* Accent Bar */}
                        <div
                          style={{
                            height: "4px",
                            background:
                              "linear-gradient(90deg, #10b981 0%, #38bdf8 100%)",
                          }}
                        />

                        <div style={{ padding: "24px 28px 14px" }}>
                          <div
                            style={{
                              display: "flex",
                              justifyContent: "space-between",
                              alignItems: "flex-start",
                              flexWrap: "wrap",
                              gap: "12px",
                            }}
                          >
                            <div>
                              <div
                                style={{
                                  fontSize: "11px",
                                  fontWeight: "800",
                                  color: "#059669",
                                  textTransform: "uppercase",
                                  letterSpacing: "1px",
                                  marginBottom: "4px",
                                }}
                              >
                                CASE FILE #{selectedRequest.id}
                              </div>
                              <h3
                                style={{
                                  margin: "0",
                                  fontWeight: "900",
                                  fontSize: "20px",
                                  color: "#0f172a",
                                }}
                              >
                                AY {selectedRequest.assessment_year} — CA
                                Assisted Filing
                              </h3>
                              <div
                                style={{
                                  fontSize: "13px",
                                  color: "#64748b",
                                  marginTop: "3px",
                                }}
                              >
                                Service:{" "}
                                <strong style={{ color: "#334155" }}>
                                  {selectedRequest.service_type
                                    .replace("_", " ")
                                    .toUpperCase()}
                                </strong>
                              </div>
                            </div>
                            <div>{getStatusBadge(selectedRequest.status)}</div>
                          </div>
                        </div>

                        <div style={{ padding: "0 28px 24px" }}>
                          {/* 4-Step Stepper */}
                          <div
                            style={{
                              background: "#f8fafc",
                              borderRadius: "14px",
                              padding: "18px 20px",
                              marginBottom: "20px",
                              border: "1px solid #e2e8f0",
                            }}
                          >
                            <div
                              style={{
                                fontWeight: "800",
                                fontSize: "11.5px",
                                color: "#64748b",
                                marginBottom: "14px",
                                textTransform: "uppercase",
                                letterSpacing: "0.8px",
                              }}
                            >
                              Filing Progress
                            </div>

                            <div
                              style={{
                                display: "flex",
                                justifyContent: "space-between",
                                flexWrap: "wrap",
                                gap: "10px",
                                fontSize: "12.5px",
                              }}
                            >
                              {[
                                { label: "1. Request Submitted", done: true },
                                {
                                  label: "2. CA Assigned",
                                  done: !!selectedRequest.assigned_employee,
                                },
                                {
                                  label: "3. Computation & Review",
                                  done: [
                                    "in_progress",
                                    "prepared",
                                    "completed",
                                  ].includes(selectedRequest.status),
                                },
                                {
                                  label: "4. Ready to File",
                                  done: !!selectedRequest.uploaded_file_path,
                                },
                              ].map((step, i) => (
                                <div
                                  key={i}
                                  style={{
                                    fontWeight: "700",
                                    color: step.done ? "#15803d" : "#94a3b8",
                                    display: "flex",
                                    alignItems: "center",
                                    gap: "6px",
                                  }}
                                >
                                  <span
                                    style={{
                                      width: "22px",
                                      height: "22px",
                                      borderRadius: "50%",
                                      background: step.done
                                        ? "#dcfce7"
                                        : "#f1f5f9",
                                      border: `2px solid ${
                                        step.done ? "#10b981" : "#cbd5e1"
                                      }`,
                                      display: "inline-flex",
                                      alignItems: "center",
                                      justifyContent: "center",
                                      fontSize: "11px",
                                      color: step.done ? "#15803d" : "#94a3b8",
                                      fontWeight: "800",
                                    }}
                                  >
                                    {step.done ? "✓" : i + 1}
                                  </span>
                                  {step.label}
                                </div>
                              ))}
                            </div>
                          </div>

                          {/* Assigned CA Professional Box */}
                          <div
                            style={{
                              background: "#f0f9ff",
                              border: "1px solid #bae6fd",
                              borderRadius: "14px",
                              padding: "16px 20px",
                              marginBottom: "20px",
                              display: "flex",
                              justifyContent: "space-between",
                              alignItems: "center",
                              flexWrap: "wrap",
                              gap: "14px",
                            }}
                          >
                            <div>
                              <div
                                style={{
                                  fontSize: "10.5px",
                                  fontWeight: "800",
                                  color: "#0369a1",
                                  textTransform: "uppercase",
                                  letterSpacing: "0.8px",
                                  marginBottom: "4px",
                                }}
                              >
                                Assigned CA Professional
                              </div>
                              <div
                                style={{
                                  fontWeight: "800",
                                  fontSize: "16px",
                                  color: "#0f172a",
                                }}
                              >
                                {selectedRequest.assigned_employee
                                  ? `👨‍💼 ${selectedRequest.assigned_employee.name}`
                                  : "Allocating best-suited Chartered Accountant..."}
                              </div>
                              {selectedRequest.assigned_employee ? (
                                <div
                                  style={{
                                    fontSize: "12.5px",
                                    color: "#475569",
                                    marginTop: "3px",
                                  }}
                                >
                                  📧 {selectedRequest.assigned_employee.email}
                                  {selectedRequest.assigned_employee.phone &&
                                    ` | 📞 ${selectedRequest.assigned_employee.phone}`}
                                </div>
                              ) : (
                                <div
                                  style={{
                                    fontSize: "12px",
                                    color: "#64748b",
                                    marginTop: "2px",
                                  }}
                                >
                                  Our partner CA will review your income sources
                                  and contact you.
                                </div>
                              )}
                            </div>

                            <div className="d-flex align-items-center gap-2 flex-wrap">
                              <button
                                onClick={() => setShowChatModal(true)}
                                style={{
                                  background: "linear-gradient(135deg, #0b1f3a 0%, #1e3a8a 100%)",
                                  border: "none",
                                  color: "#ffffff",
                                  padding: "8px 18px",
                                  borderRadius: "8px",
                                  fontSize: "13px",
                                  fontWeight: "800",
                                  cursor: "pointer",
                                  display: "inline-flex",
                                  alignItems: "center",
                                  gap: "7px",
                                  boxShadow: "0 3px 10px rgba(11,31,58,0.25)",
                                }}
                              >
                                <span>💬</span>
                                <span>Chat with CA</span>
                                <span
                                  style={{
                                    width: "7px",
                                    height: "7px",
                                    borderRadius: "50%",
                                    background: "#22c55e",
                                    display: "inline-block",
                                    boxShadow: "0 0 8px #22c55e",
                                  }}
                                />
                              </button>

                              <button
                                onClick={() => setShowContactModal(true)}
                                style={{
                                  background: "#ffffff",
                                  border: "1px solid #38bdf8",
                                  color: "#0284c7",
                                  padding: "8px 18px",
                                  borderRadius: "8px",
                                  fontSize: "13px",
                                  fontWeight: "700",
                                  cursor: "pointer",
                                  boxShadow: "0 2px 6px rgba(56,189,248,0.15)",
                                }}
                              >
                                📞 Request Callback
                              </button>
                            </div>
                          </div>

                          {/* File Download / Professional Computation Deliverables Box */}
                          {(selectedRequest.uploaded_file_path || selectedRequest.status === "prepared" || selectedRequest.tax_summary) ? (
                            <div
                              style={{
                                background: "#ffffff",
                                border: "1.5px solid #86efac",
                                borderRadius: "16px",
                                padding: "20px 24px",
                                marginBottom: "22px",
                                boxShadow: "0 4px 16px rgba(16,185,129,0.08)",
                              }}
                            >
                              <div className="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                                <div>
                                  <div style={{ fontWeight: "800", color: "#15803d", fontSize: "16px" }}>
                                    🎉 Your Final ITR Return File &amp; Computation is Ready!
                                  </div>
                                  <div style={{ color: "#166534", fontSize: "13px", marginTop: "2px" }}>
                                    Prepared and certified by your assigned CA specialist for <strong>AY {selectedRequest.assessment_year || "2026-27"}</strong>.
                                  </div>
                                </div>
                                <span className="badge bg-success px-3 py-2" style={{ fontSize: "12px", textTransform: "uppercase" }}>
                                  {selectedRequest.status}
                                </span>
                              </div>

                              {/* Executive 4-KPI Summary Preview – always visible */}
                              {selectedRequest.tax_summary && (
                                <div
                                  style={{
                                    background: "linear-gradient(135deg, #0b1f3a 0%, #1e3a8a 100%)",
                                    color: "#ffffff",
                                    borderRadius: "12px",
                                    padding: "16px 20px",
                                    marginBottom: "18px",
                                  }}
                                >
                                  <div className="row g-2 text-center">
                                    <div className="col-6 col-md-3">
                                      <div style={{ fontSize: "11px", opacity: 0.8 }}>RECOMMENDED REGIME</div>
                                      <div style={{ fontWeight: "800", color: "#facc15", fontSize: "14px", marginTop: "2px" }}>
                                        {(selectedRequest.chosen_regime || selectedRequest.tax_summary.chosen_regime || "NEW").toUpperCase()} REGIME
                                      </div>
                                    </div>
                                    <div className="col-6 col-md-3">
                                      <div style={{ fontSize: "11px", opacity: 0.8 }}>FINAL TAX LIABILITY</div>
                                      <div style={{ fontWeight: "800", fontSize: "14px", marginTop: "2px" }}>
                                        ₹{(selectedRequest.tax_summary.final_tax || 0).toLocaleString("en-IN")}
                                      </div>
                                    </div>
                                    <div className="col-6 col-md-3">
                                      <div style={{ fontSize: "11px", opacity: 0.8 }}>REFUND DUE TO YOU</div>
                                      <div style={{ fontWeight: "800", color: "#4ade80", fontSize: "14px", marginTop: "2px" }}>
                                        ₹{(selectedRequest.tax_summary.refund_due || 0).toLocaleString("en-IN")}
                                      </div>
                                    </div>
                                    <div className="col-6 col-md-3">
                                      <div style={{ fontSize: "11px", opacity: 0.8 }}>TAX SAVINGS ACHIEVED</div>
                                      <div style={{ fontWeight: "800", color: "#38bdf8", fontSize: "14px", marginTop: "2px" }}>
                                        ₹{(selectedRequest.tax_summary.tax_savings || 0).toLocaleString("en-IN")}
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              )}

                              {/* ════ PAYMENT GATE — show when not yet paid ════ */}
                              {!caPaymentCompleted && (
                                <div style={{ background: "linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%)", border: "2px solid #6ee7b7", borderRadius: "14px", padding: "20px 24px", marginBottom: "16px" }}>
                                  <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", flexWrap: "wrap", gap: "16px" }}>
                                    {/* Fee breakdown */}
                                    <div style={{ flex: 1, minWidth: "220px" }}>
                                      <div style={{ fontWeight: "900", color: "#14532d", fontSize: "15px", marginBottom: "6px" }}>🔒 Complete Payment to Unlock Your Filed Return</div>
                                      <div style={{ fontSize: "13px", color: "#166534", lineHeight: "1.6", marginBottom: "12px" }}>
                                        Your CA has prepared and certified your return. Pay the filing fee to unlock the full computation sheet, download the official ITR JSON, PDF, and grant e-filing authorization.
                                      </div>
                                      <div style={{ display: "flex", flexDirection: "column", gap: "4px", fontSize: "13px", color: "#166534" }}>
                                        <div style={{ display: "flex", justifyContent: "space-between", maxWidth: "260px" }}>
                                          <span>CA-Assisted Filing Fee</span>
                                          <strong>₹{CA_FILING_FEE}</strong>
                                        </div>
                                        <div style={{ display: "flex", justifyContent: "space-between", maxWidth: "260px" }}>
                                          <span>GST @ 18%</span>
                                          <strong>₹{CA_FILING_FEE_GST}</strong>
                                        </div>
                                        <div style={{ display: "flex", justifyContent: "space-between", maxWidth: "260px", borderTop: "1px dashed #6ee7b7", paddingTop: "6px", marginTop: "4px" }}>
                                          <span style={{ fontWeight: "800", color: "#14532d" }}>Total Payable</span>
                                          <strong style={{ color: "#14532d", fontSize: "15px" }}>₹{CA_FILING_FEE_TOTAL}</strong>
                                        </div>
                                      </div>
                                      <div style={{ marginTop: "8px", fontSize: "11px", color: "#6ee7b7" }}>
                                        🔐 Secured by Razorpay &nbsp;|&nbsp; UPI / Cards / Net Banking / Wallets
                                      </div>
                                    </div>
                                    {/* Pay button */}
                                    <div style={{ display: "flex", flexDirection: "column", alignItems: "center", gap: "10px", minWidth: "160px" }}>
                                      <button
                                        onClick={handleCaAssistedPayNow}
                                        disabled={caPaymentProcessing}
                                        style={{
                                          background: caPaymentProcessing ? "#64748b" : "linear-gradient(135deg, #15803d, #16a34a)",
                                          color: "#fff", border: "none", borderRadius: "12px",
                                          padding: "14px 24px", fontWeight: "900", fontSize: "14px",
                                          cursor: caPaymentProcessing ? "not-allowed" : "pointer",
                                          boxShadow: "0 4px 14px rgba(21,128,61,0.4)",
                                          width: "100%", transition: "all 0.2s",
                                        }}
                                      >
                                        {caPaymentProcessing ? "⏳ Processing..." : `💳 Pay ₹${CA_FILING_FEE_TOTAL} & Unlock`}
                                      </button>
                                      <div style={{ fontSize: "10px", color: "#6b7280", textAlign: "center" }}>🔒 100% Secure &amp; Encrypted</div>
                                      <div style={{ display: "flex", gap: "5px", flexWrap: "wrap", justifyContent: "center" }}>
                                        {["UPI", "Cards", "Net Banking", "Wallets"].map(m => (
                                          <span key={m} style={{ background: "#d1fae5", color: "#065f46", fontSize: "10px", fontWeight: "700", padding: "2px 7px", borderRadius: "6px" }}>{m}</span>
                                        ))}
                                      </div>
                                    </div>
                                  </div>

                                  {/* Locked action buttons preview */}
                                  <div style={{ marginTop: "18px", borderTop: "1px dashed #6ee7b7", paddingTop: "14px" }}>
                                    <div style={{ fontSize: "11px", fontWeight: "700", color: "#9ca3af", marginBottom: "8px", textTransform: "uppercase", letterSpacing: "0.5px" }}>🔐 Unlocks after payment:</div>
                                    <div style={{ display: "flex", flexWrap: "wrap", gap: "8px" }}>
                                      {[
                                        { icon: "📜", label: "View Full Computation Sheet" },
                                        { icon: "📥", label: "Download ITR JSON" },
                                        { icon: "🖨️", label: "Download / Print PDF" },
                                        { icon: "✅", label: "Approve & Authorize CA Filing" },
                                      ].map(btn => (
                                        <button key={btn.label} disabled style={{ background: "#f3f4f6", border: "1px solid #e5e7eb", borderRadius: "8px", padding: "7px 14px", fontSize: "12px", color: "#9ca3af", cursor: "not-allowed", fontWeight: "600" }}>
                                          {btn.icon} {btn.label}
                                        </button>
                                      ))}
                                    </div>
                                  </div>
                                </div>
                              )}

                              {/* ════ POST-PAYMENT: Unlocked actions ════ */}
                              {caPaymentCompleted && (
                                <>
                                  {/* Payment verified banner */}
                                  <div style={{ background: "#ecfdf5", border: "2px solid #86efac", borderRadius: "12px", padding: "14px 18px", marginBottom: "14px", display: "flex", alignItems: "center", gap: "12px" }}>
                                    <span style={{ fontSize: "28px" }}>✅</span>
                                    <div style={{ flex: 1 }}>
                                      <div style={{ fontWeight: "900", color: "#14532d", fontSize: "14px" }}>Payment Verified! All files unlocked.</div>
                                      <div style={{ fontSize: "12px", color: "#166534", marginTop: "2px" }}>
                                        Txn ID: <strong>{caPaymentInfo?.razorpay_payment_id || "–"}</strong>
                                        &nbsp;|&nbsp; Amount: <strong>₹{caPaymentInfo?.amount || CA_FILING_FEE_TOTAL}</strong>
                                        &nbsp;|&nbsp; {caPaymentInfo?.paid_at ? new Date(caPaymentInfo.paid_at).toLocaleString("en-IN") : ""}
                                      </div>
                                    </div>
                                    <span style={{ background: "#bbf7d0", color: "#14532d", fontWeight: "800", fontSize: "11px", padding: "3px 10px", borderRadius: "20px" }}>PAID</span>
                                  </div>

                                  {/* Action Buttons: View Dossier, Download JSON, Download PDF */}
                                  <div className="d-flex align-items-center gap-2 flex-wrap mb-3">
                                    <button
                                      type="button"
                                      onClick={() => setShowDossierModal(true)}
                                      className="btn btn-primary fw-bold d-flex align-items-center gap-2 text-white"
                                      style={{
                                        background: "linear-gradient(135deg, #0b3d91 0%, #1a5bb8 100%)",
                                        border: "none",
                                        borderRadius: "8px",
                                        padding: "9px 18px",
                                        fontSize: "13px",
                                      }}
                                    >
                                      <span>📜</span> View Full Tax Computation Sheet
                                    </button>

                                    <button
                                      type="button"
                                      onClick={() => setShowDossierModal(true)}
                                      className="btn btn-outline-success fw-bold d-flex align-items-center gap-2"
                                      style={{ borderRadius: "8px", padding: "9px 18px", fontSize: "13px" }}
                                    >
                                      <span>📥</span> Download Official ITR JSON
                                    </button>

                                    <button
                                      type="button"
                                      onClick={() => setShowDossierModal(true)}
                                      className="btn btn-outline-dark fw-bold d-flex align-items-center gap-2"
                                      style={{ borderRadius: "8px", padding: "9px 18px", fontSize: "13px" }}
                                    >
                                      <span>🖨️</span> Download / Print PDF
                                    </button>
                                  </div>

                                  {/* Customer Approval CTA */}
                                  {selectedRequest.status === "prepared" && !selectedRequest.customer_approved_at && (
                                    <div
                                      style={{
                                        background: "linear-gradient(135deg, #f0fdf4, #dcfce7)",
                                        border: "2px solid #16a34a",
                                        borderRadius: "12px",
                                        padding: "16px 20px",
                                      }}
                                    >
                                      <div style={{ fontWeight: "800", fontSize: "14px", color: "#15803d", marginBottom: "4px" }}>
                                        ✍️ Step 2: Authorize Your CA to Submit
                                      </div>
                                      <p style={{ fontSize: "12.5px", color: "#166534", marginBottom: "12px", lineHeight: "1.6" }}>
                                        Please review your computed tax sheet above. Once satisfied, click below to grant your digital authorization so your CA can submit your return to the Income Tax Department e-Filing portal.
                                      </p>
                                      <button
                                        id="btn-customer-approve-filing"
                                        onClick={async () => {
                                          if (!window.confirm("I confirm I have reviewed my tax calculation sheet and authorize my Chartered Accountant to submit my return for AY " + selectedRequest.assessment_year + ".")) return;
                                          try {
                                            await api.post("/agent-requests/" + selectedRequest.id + "/customer-approve", {
                                              declaration: true,
                                              assessment_year: selectedRequest.assessment_year,
                                            });
                                            setFeedback({
                                              type: "success",
                                              message: "Your ITR filing has been approved! Your CA has been notified and will now submit it to the IT portal.",
                                            });
                                            fetchMyRequests();
                                          } catch (err) {
                                            setFeedback({
                                              type: "danger",
                                              message: err.response?.data?.message || "Approval failed. Please try again.",
                                            });
                                          }
                                        }}
                                        style={{
                                          padding: "10px 22px",
                                          background: "linear-gradient(135deg, #16a34a, #15803d)",
                                          color: "#fff",
                                          border: "none",
                                          borderRadius: "10px",
                                          fontWeight: "800",
                                          fontSize: "13.5px",
                                          cursor: "pointer",
                                          boxShadow: "0 4px 14px rgba(22,163,74,0.4)",
                                          display: "inline-flex",
                                          alignItems: "center",
                                          gap: "8px",
                                        }}
                                      >
                                        ✅ Approve &amp; Authorize CA Filing
                                      </button>
                                    </div>
                                  )}

                                  {selectedRequest.customer_approved_at && (
                                    <div
                                      style={{
                                        background: "#ecfdf5",
                                        border: "1px solid #6ee7b7",
                                        borderRadius: "8px",
                                        padding: "10px 14px",
                                        fontSize: "12.5px",
                                        color: "#065f46",
                                        fontWeight: "700",
                                      }}
                                    >
                                      ✓ You approved this tax return on {new Date(selectedRequest.customer_approved_at).toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" })}.
                                    </div>
                                  )}
                                </>
                              )}
                            </div>
                          ) : (
                            <div
                              style={{
                                background: "#fffbeb",
                                border: "1px dashed #fcd34d",
                                borderRadius: "12px",
                                padding: "16px 20px",
                                fontSize: "13px",
                                color: "#b45309",
                                marginBottom: "20px",
                                fontWeight: "600",
                                display: "flex",
                                alignItems: "center",
                                gap: "10px",
                              }}
                            >
                              <span style={{ fontSize: "20px" }}>⏳</span>
                              <span>
                                Your return is currently being prepared and reconciled with AIS / Form 26AS by your assigned CA. Once prepared, your computation sheet and official JSON will appear here for your review and 1-click download.
                              </span>
                            </div>
                          )}

                          {/* Uploaded Supporting Documents */}
                          {selectedRequest.details?.customer_documents?.length >
                            0 && (
                            <div>
                              <div
                                style={{
                                  fontWeight: "800",
                                  fontSize: "11.5px",
                                  color: "#64748b",
                                  marginBottom: "8px",
                                  textTransform: "uppercase",
                                  letterSpacing: "0.5px",
                                }}
                              >
                                Attached Documents:
                              </div>
                              <div
                                style={{
                                  display: "flex",
                                  flexWrap: "wrap",
                                  gap: "8px",
                                }}
                              >
                                {selectedRequest.details.customer_documents.map(
                                  (doc, idx) => (
                                    <a
                                      key={idx}
                                      href={doc.url}
                                      target="_blank"
                                      rel="noreferrer"
                                      style={{
                                        display: "inline-flex",
                                        alignItems: "center",
                                        gap: "6px",
                                        padding: "6px 14px",
                                        background: "#f8fafc",
                                        border: "1px solid #e2e8f0",
                                        borderRadius: "8px",
                                        fontSize: "12px",
                                        color: "#334155",
                                        textDecoration: "none",
                                        fontWeight: "600",
                                      }}
                                    >
                                      📄 {doc.original_name}
                                    </a>
                                  )
                                )}
                              </div>
                            </div>
                          )}
                        </div>
                      </div>

                      {/* Live Communication & Support Action Card */}
                      <div
                        style={{
                          background: "#ffffff",
                          border: "1px solid #e2e8f0",
                          borderRadius: "16px",
                          padding: "20px 24px",
                          display: "flex",
                          justifyContent: "space-between",
                          alignItems: "center",
                          flexWrap: "wrap",
                          gap: "16px",
                          boxShadow: "0 2px 10px rgba(0,0,0,0.03)",
                        }}
                      >
                        <div className="d-flex align-items-center gap-3">
                          <div
                            style={{
                              width: "48px",
                              height: "48px",
                              borderRadius: "12px",
                              background: "#e0f2fe",
                              color: "#0369a1",
                              display: "flex",
                              alignItems: "center",
                              justifyContent: "center",
                              fontSize: "24px",
                              flexShrink: 0,
                            }}
                          >
                            💬
                          </div>
                          <div>
                            <div
                              style={{
                                fontWeight: "800",
                                color: "#0f172a",
                                fontSize: "15px",
                                display: "flex",
                                alignItems: "center",
                                gap: "8px",
                              }}
                            >
                              <span>Direct CA Specialist Chat</span>
                              <span
                                style={{
                                  fontSize: "11px",
                                  padding: "2px 8px",
                                  borderRadius: "100px",
                                  background: "#dcfce7",
                                  color: "#15803d",
                                  fontWeight: "700",
                                }}
                              >
                                ● Specialist Available
                              </span>
                            </div>
                            <div
                              style={{
                                color: "#64748b",
                                fontSize: "13px",
                                marginTop: "3px",
                              }}
                            >
                              Have doubts about deductions, Form 16, or tax computation? Chat directly with your CA.
                            </div>
                          </div>
                        </div>

                        <button
                          onClick={() => setShowChatModal(true)}
                          style={{
                            background: "linear-gradient(135deg, #0b1f3a 0%, #1e3a8a 100%)",
                            border: "none",
                            color: "#ffffff",
                            padding: "11px 24px",
                            borderRadius: "10px",
                            fontSize: "14px",
                            fontWeight: "800",
                            cursor: "pointer",
                            display: "flex",
                            alignItems: "center",
                            gap: "8px",
                            boxShadow: "0 4px 14px rgba(11,31,58,0.25)",
                            transition: "all 0.15s",
                          }}
                        >
                          <span>💬 Open Live Chat</span>
                          <span
                            style={{
                              width: "8px",
                              height: "8px",
                              borderRadius: "50%",
                              background: "#22c55e",
                              display: "inline-block",
                              boxShadow: "0 0 8px #22c55e",
                            }}
                          />
                        </button>
                      </div>
                    </div>
                  ) : (
                    <div
                      style={{
                        ...cardStyle,
                        textAlign: "center",
                        padding: "60px 32px",
                        color: "#64748b",
                        fontWeight: "600",
                      }}
                    >
                      Select a filing case from the left to view details &amp;
                      chat.
                    </div>
                  )}
                </CCol>
              </CRow>
            )}
          </div>
        )}

        {/* ═══════════ VIEW 2: NEW HIRE AGENT FORM ═══════════ */}
        {activeTab === "new_request" && (
          <CRow className="justify-content-center">
            <CCol lg={9}>
              <div style={{ ...cardStyle, overflow: "hidden" }}>
                {/* Form Header */}
                <div
                  style={{
                    padding: "26px 32px",
                    background:
                      "linear-gradient(135deg, #0b1f3a 0%, #1e3a8a 100%)",
                    color: "#ffffff",
                  }}
                >
                  <div
                    style={{
                      fontSize: "11px",
                      fontWeight: "800",
                      textTransform: "uppercase",
                      letterSpacing: "1.2px",
                      color: "#38bdf8",
                      marginBottom: "6px",
                    }}
                  >
                    Expert Tax Assistance
                  </div>
                  <h2
                    style={{
                      fontWeight: "900",
                      fontSize: "22px",
                      margin: "0 0 6px",
                      color: "#ffffff",
                    }}
                  >
                    Hire a Dedicated Chartered Accountant
                  </h2>
                  <p
                    style={{
                      margin: 0,
                      color: "#94a3b8",
                      fontSize: "13.5px",
                      lineHeight: "1.5",
                    }}
                  >
                    Our certified Chartered Accountants handle your end-to-end
                    tax filing, maximize deductions, compare Old vs New regime,
                    and file your return securely.
                  </p>
                </div>

                {/* Form Body */}
                <div style={{ padding: "30px 32px" }}>
                  <CForm onSubmit={handleSubmitRequest}>
                    <CRow className="g-4">
                      {/* PAN */}
                      <CCol md={6}>
                        <label
                          style={{
                            fontSize: "12px",
                            fontWeight: "800",
                            color: "#475569",
                            textTransform: "uppercase",
                            letterSpacing: "0.5px",
                            marginBottom: "8px",
                            display: "block",
                          }}
                        >
                          Income Tax PAN
                        </label>
                        <div
                          style={{
                            padding: "12px 16px",
                            background: "#f1f5f9",
                            border: "1px solid #cbd5e1",
                            borderRadius: "10px",
                            fontWeight: "800",
                            color: "#0f172a",
                            fontSize: "15px",
                            letterSpacing: "2px",
                          }}
                        >
                          {storedPan}
                        </div>
                      </CCol>

                      {/* Assessment Year */}
                      <CCol md={6}>
                        <label
                          style={{
                            fontSize: "12px",
                            fontWeight: "800",
                            color: "#475569",
                            textTransform: "uppercase",
                            letterSpacing: "0.5px",
                            marginBottom: "8px",
                            display: "block",
                          }}
                        >
                          Assessment Year
                        </label>
                        <select
                          value={assessmentYear}
                          onChange={(e) => setAssessmentYear(e.target.value)}
                          style={{
                            width: "100%",
                            padding: "12px 16px",
                            background: "#ffffff",
                            border: "1px solid #cbd5e1",
                            borderRadius: "10px",
                            fontWeight: "700",
                            color: "#0f172a",
                            fontSize: "14px",
                            outline: "none",
                            cursor: "pointer",
                          }}
                        >
                          <option value="2026-27">
                            AY 2026-27 (FY 2025-26) - Current Filing Year
                          </option>
                          <option value="2025-26">
                            AY 2025-26 (FY 2024-25)
                          </option>
                        </select>
                      </CCol>

                      {/* Service Plan */}
                      <CCol md={12}>
                        <label
                          style={{
                            fontSize: "12px",
                            fontWeight: "800",
                            color: "#475569",
                            textTransform: "uppercase",
                            letterSpacing: "0.5px",
                            marginBottom: "12px",
                            display: "block",
                          }}
                        >
                          Select CA Filing Service Plan
                        </label>
                        <CRow className="g-3">
                          {[
                            {
                              id: "full_filing",
                              emoji: "📋",
                              title: "End-to-End CA Filing",
                              desc: "CA reviews AIS, Form 16, prepares computation, files ITR and provides official acknowledgment.",
                            },
                            {
                              id: "capital_gains",
                              emoji: "📈",
                              title: "Capital Gains & Trading",
                              desc: "Share trading, mutual funds, crypto, property sale and P&L computation optimization.",
                            },
                            {
                              id: "business_profession",
                              emoji: "💼",
                              title: "Business / Profession",
                              desc: "Freelancers, doctors, consultants — 44AD/ADA presumptive computation and balance sheet.",
                            },
                          ].map((plan) => {
                            const isChosen = serviceType === plan.id;
                            return (
                              <CCol md={4} key={plan.id}>
                                <div
                                  onClick={() => setServiceType(plan.id)}
                                  style={{
                                    padding: "18px",
                                    borderRadius: "14px",
                                    cursor: "pointer",
                                    border: isChosen
                                      ? "2px solid #10b981"
                                      : "1.5px solid #e2e8f0",
                                    background: isChosen
                                      ? "#f0fdf4"
                                      : "#ffffff",
                                    transition: "all 0.18s",
                                    height: "100%",
                                    boxShadow: isChosen
                                      ? "0 4px 16px rgba(16,185,129,0.15)"
                                      : "none",
                                  }}
                                >
                                  <div
                                    style={{
                                      fontSize: "26px",
                                      marginBottom: "8px",
                                    }}
                                  >
                                    {plan.emoji}
                                  </div>
                                  <div
                                    style={{
                                      fontWeight: "800",
                                      color: isChosen ? "#059669" : "#0f172a",
                                      fontSize: "14px",
                                      marginBottom: "6px",
                                    }}
                                  >
                                    {plan.title}
                                  </div>
                                  <div
                                    style={{
                                      color: "#64748b",
                                      fontSize: "12px",
                                      lineHeight: "1.5",
                                    }}
                                  >
                                    {plan.desc}
                                  </div>
                                </div>
                              </CCol>
                            );
                          })}
                        </CRow>
                      </CCol>

                      {/* Income Sources */}
                      <CCol md={12}>
                        <label
                          style={{
                            fontSize: "12px",
                            fontWeight: "800",
                            color: "#475569",
                            textTransform: "uppercase",
                            letterSpacing: "0.5px",
                            marginBottom: "10px",
                            display: "block",
                          }}
                        >
                          Income Sources (Select all that apply)
                        </label>
                        <div
                          style={{
                            display: "flex",
                            flexWrap: "wrap",
                            gap: "8px",
                          }}
                        >
                          {incomeSourceOptions.map((source) => {
                            const isSelected = selectedSources.includes(source);
                            return (
                              <div
                                key={source}
                                onClick={() => toggleSource(source)}
                                style={{
                                  padding: "8px 16px",
                                  borderRadius: "100px",
                                  fontSize: "13px",
                                  fontWeight: "700",
                                  cursor: "pointer",
                                  transition: "all 0.15s",
                                  border: isSelected
                                    ? "1.5px solid #10b981"
                                    : "1px solid #cbd5e1",
                                  background: isSelected
                                    ? "#ecfdf5"
                                    : "#ffffff",
                                  color: isSelected ? "#059669" : "#475569",
                                }}
                              >
                                {isSelected ? "✓ " : "+ "}
                                {source}
                              </div>
                            );
                          })}
                        </div>
                      </CCol>

                      {/* Notes */}
                      <CCol md={12}>
                        <label
                          style={{
                            fontSize: "12px",
                            fontWeight: "800",
                            color: "#475569",
                            textTransform: "uppercase",
                            letterSpacing: "0.5px",
                            marginBottom: "8px",
                            display: "block",
                          }}
                        >
                          Special Instructions for your CA
                        </label>
                        <textarea
                          rows={3}
                          value={notes}
                          onChange={(e) => setNotes(e.target.value)}
                          placeholder="e.g. Switched jobs this year, have medical insurance of ₹35k, sold mutual funds in Dec 2025..."
                          style={{
                            width: "100%",
                            padding: "12px 16px",
                            background: "#ffffff",
                            border: "1px solid #cbd5e1",
                            borderRadius: "10px",
                            color: "#0f172a",
                            fontSize: "14px",
                            resize: "vertical",
                            outline: "none",
                            lineHeight: "1.6",
                            boxSizing: "border-box",
                          }}
                        />
                      </CCol>

                      {/* File Upload */}
                      <CCol md={12}>
                        <label
                          style={{
                            fontSize: "12px",
                            fontWeight: "800",
                            color: "#475569",
                            textTransform: "uppercase",
                            letterSpacing: "0.5px",
                            marginBottom: "8px",
                            display: "block",
                          }}
                        >
                          Upload Supporting Documents (Optional)
                        </label>
                        <div
                          style={{
                            border: "2px dashed #cbd5e1",
                            borderRadius: "12px",
                            padding: "24px",
                            textAlign: "center",
                            background: "#f8fafc",
                            cursor: "pointer",
                            position: "relative",
                          }}
                        >
                          <input
                            type="file"
                            multiple
                            onChange={handleFileChange}
                            accept=".pdf,.png,.jpg,.jpeg,.zip,.csv,.xlsx"
                            style={{
                              position: "absolute",
                              inset: 0,
                              opacity: 0,
                              cursor: "pointer",
                            }}
                          />
                          <div
                            style={{ fontSize: "32px", marginBottom: "8px" }}
                          >
                            📁
                          </div>
                          <div
                            style={{
                              fontWeight: "700",
                              color: "#0f172a",
                              fontSize: "14px",
                            }}
                          >
                            {files.length > 0
                              ? `${files.length} file(s) selected`
                              : "Click or drag tax documents here"}
                          </div>
                          <div
                            style={{
                              fontSize: "12px",
                              color: "#64748b",
                              marginTop: "4px",
                            }}
                          >
                            PDF, Excel, Images supported (Max 20MB). Encrypted &amp;
                            Confidential.
                          </div>
                        </div>
                      </CCol>

                      {/* Submit */}
                      <CCol md={12} style={{ marginTop: "8px" }}>
                        <button
                          type="submit"
                          disabled={submitting}
                          style={{
                            width: "100%",
                            padding: "16px",
                            borderRadius: "12px",
                            background: submitting
                              ? "rgba(16,185,129,0.5)"
                              : "linear-gradient(135deg, #10b981 0%, #059669 100%)",
                            border: "none",
                            color: "#fff",
                            fontSize: "15.5px",
                            fontWeight: "800",
                            cursor: submitting ? "not-allowed" : "pointer",
                            boxShadow: "0 4px 18px rgba(16,185,129,0.35)",
                            display: "flex",
                            alignItems: "center",
                            justifyContent: "center",
                            gap: "10px",
                            transition: "all 0.2s",
                          }}
                        >
                          {submitting ? (
                            <>
                              <CSpinner size="sm" />
                              Booking Your CA Request...
                            </>
                          ) : (
                            "Submit Request & Assign CA Specialist →"
                          )}
                        </button>
                      </CCol>
                    </CRow>
                  </CForm>
                </div>
              </div>
            </CCol>
          </CRow>
        )}
      </CContainer>

      {/* Floating Chat Launcher Button */}
      {selectedRequest && (
        <button
          onClick={() => setShowChatModal(true)}
          style={{
            position: "fixed",
            bottom: "26px",
            right: "26px",
            zIndex: 1040,
            background: "linear-gradient(135deg, #0b1f3a 0%, #1e3a8a 100%)",
            color: "#ffffff",
            border: "2px solid rgba(255,255,255,0.25)",
            borderRadius: "100px",
            padding: "12px 22px",
            fontSize: "14px",
            fontWeight: "800",
            cursor: "pointer",
            boxShadow: "0 8px 25px rgba(11,31,58,0.35)",
            display: "flex",
            alignItems: "center",
            gap: "9px",
            transition: "all 0.2s",
          }}
          onMouseEnter={(e) => {
            e.currentTarget.style.transform = "scale(1.05)";
          }}
          onMouseLeave={(e) => {
            e.currentTarget.style.transform = "scale(1)";
          }}
          title="Open Live Chat with CA Specialist"
        >
          <span style={{ fontSize: "18px" }}>💬</span>
          <span>Chat with CA</span>
          <span
            style={{
              width: "8px",
              height: "8px",
              borderRadius: "50%",
              background: "#22c55e",
              display: "inline-block",
              boxShadow: "0 0 8px #22c55e",
            }}
          />
        </button>
      )}

      {/* Live Chat Modal */}
      <CModal
        visible={showChatModal}
        onClose={() => setShowChatModal(false)}
        size="lg"
        alignment="center"
        backdrop="static"
      >
        <CModalHeader
          onClose={() => setShowChatModal(false)}
          style={{
            background: "linear-gradient(135deg, #0b1f3a 0%, #1e3a8a 100%)",
            color: "#ffffff",
            borderBottom: "1px solid rgba(255,255,255,0.1)",
            padding: "16px 22px",
          }}
        >
          <CModalTitle
            style={{
              fontSize: "16px",
              fontWeight: "800",
              color: "#ffffff",
              display: "flex",
              alignItems: "center",
              gap: "10px",
            }}
          >
            <span>💬 Live Chat with CA Staff</span>
            {selectedRequest && (
              <span
                style={{
                  fontSize: "11.5px",
                  background: "rgba(56,189,248,0.2)",
                  color: "#38bdf8",
                  padding: "3px 10px",
                  borderRadius: "100px",
                  fontWeight: "700",
                }}
              >
                Case #{selectedRequest.id}
              </span>
            )}
          </CModalTitle>
        </CModalHeader>
        <CModalBody style={{ padding: 0 }}>
          {selectedRequest && (
            <AgentChat
              requestId={selectedRequest.id}
              isAgentOrAdmin={false}
              currentUserName={user.name || "Customer"}
            />
          )}
        </CModalBody>
      </CModal>

      <ContactUsModal
        visible={showContactModal}
        onClose={() => setShowContactModal(false)}
      />

      {/* Official Tax Computation Sheet & Export Modal */}
      <TaxComputationDossier
        visible={showDossierModal}
        onClose={() => setShowDossierModal(false)}
        requestData={selectedRequest}
        isCA={false}
      />
    </div>
  );
}
